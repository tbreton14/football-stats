<div class="col-12">
    <div class="content-block mb-3">
        <div class="content-block-header">
            Galerie
        </div>
        <div class="content-block-body">
            <div class="row" id="photo-list">
                {% for photo in photos %}
                    {% set photoUrl = asset(photo.imagePath) %}
                    <div class="col-6 col-lg-4 mb-3">
                        <a class="linkGooglePhoto" href="{{ photoUrl }}" data-fslightbox="gallery" data-type="image">
                            <img src="{{ photoUrl }}" alt="{{ photo.title|default('Photo') }}" class="w-100 mb-2 img-google" style="object-fit: cover; height: 200px;" />
                        </a>
                        {% if photo.title %}
                            <div class="text-muted small text-center">{{ photo.title }}</div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>